<?xml version="1.0" encoding="UTF-8"?>
<!--
  components.xsd — schema for the per-component XML files in
  components/, generated by ../toXML.py from the markdown components.

  Validate with `make lint` in this directory.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <!-- ========================================== component (root) -->

  <xs:element name="component">
    <xs:complexType>
      <xs:sequence>
        <!-- the category's display title, e.g. "Adoration" -->
        <xs:element name="subject" type="xs:string"/>
        <!-- [Title] line, present only when it differs from the subject -->
        <xs:element name="title" type="xs:string" minOccurs="0"/>
        <!-- who the text is attributed to, e.g. "Anselm of Canterbury",
             or the scripture reference it quotes, e.g. "Psalm 95:1-2,7"
             (extracted from the header line; at most one of the two) -->
        <xs:element name="author" type="xs:string" minOccurs="0"/>
        <xs:element name="scripture" type="xs:string" minOccurs="0"/>
        <!-- bibliographic citation of the source; the optional ref
             attribute lists ids of shared source records, resolved as
             sources/<id>.xml (space-separated when several match) -->
        <xs:element name="source" minOccurs="0">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="xs:string">
                <xs:attribute name="ref">
                  <xs:simpleType>
                    <xs:list itemType="xs:NCName"/>
                  </xs:simpleType>
                </xs:attribute>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
        <!-- the pre-modernization original text: plain text (as
             migrated) or structured with the same p/line/response
             model as <text> blocks -->
        <xs:element name="original" minOccurs="0">
          <xs:complexType mixed="true">
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:group ref="blockElements"/>
            </xs:choice>
          </xs:complexType>
        </xs:element>
        <xs:element name="updated" type="xs:string" minOccurs="0"/>
        <xs:element name="notes" type="xs:string" minOccurs="0"/>
        <xs:element name="meta" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="xs:string">
                <xs:attribute name="key" type="xs:string" use="required"/>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
        <xs:element ref="text"/>
      </xs:sequence>
      <!-- id is "category.filename" (without .md): the extraction key.
           Category ids never contain ".", so the first "." separates
           category from filename; the source file is
           components/<category>/<filename>.md -->
      <xs:attribute name="id" type="componentId" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:simpleType name="componentId">
    <xs:restriction base="xs:string">
      <xs:pattern value="[^./\s]+\.[^/\s]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ================================================= prayer text -->

  <xs:element name="text">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="block" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- the content elements a block (or a structured <original>) holds -->
  <xs:group name="blockElements">
    <xs:choice>
      <xs:element name="p" type="lineGroup"/>
      <xs:element name="response" type="lineGroup"/>
      <xs:element name="rubric" type="xs:string"/>
      <xs:element name="heading" type="headingType"/>
    </xs:choice>
  </xs:group>

  <xs:element name="block">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="blockElements"/>
      </xs:choice>
      <!-- fenced-block types from the markdown dialect; bare content
           defaults to "prayer" -->
      <xs:attribute name="type" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="prayer"/>
            <xs:enumeration value="scripture"/>
            <xs:enumeration value="service-header"/>
            <xs:enumeration value="welcome"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <!-- ================================================ text content -->

  <!-- A paragraph or congregational response.  Either directly holds
       mixed inline content (single hard line) or a sequence of <line>
       children (multiple hard lines / verse).  indent counts the ~
       levels from the source. -->
  <xs:complexType name="lineGroup" mixed="true">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="line" type="lineType"/>
      <xs:group ref="inlineElements"/>
    </xs:choice>
    <xs:attribute name="indent" type="xs:nonNegativeInteger"/>
  </xs:complexType>

  <xs:complexType name="lineType" mixed="true">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="inlineElements"/>
    </xs:choice>
    <xs:attribute name="indent" type="xs:nonNegativeInteger"/>
  </xs:complexType>

  <xs:complexType name="headingType" mixed="true">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="inlineElements"/>
    </xs:choice>
    <xs:attribute name="level" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:positiveInteger">
          <xs:maxInclusive value="6"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:group name="inlineElements">
    <xs:choice>
      <xs:element name="em" type="xs:string"/>
      <xs:element name="strong" type="xs:string"/>
      <!-- {option: a / b} alternatives, e.g. in the Lord's Prayer -->
      <xs:element name="option" type="xs:string"/>
    </xs:choice>
  </xs:group>

</xs:schema>
